{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install seed dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["ci"],
      "options": {
        "cwd": "${workspaceFolder}/tool/seed"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Firebase emulators",
      "type": "shell",
      "command": "firebase",
      "args": ["emulators:start"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "All emulators ready! It is now safe to connect your app\\."
        }
      }
    },
    {
      "label": "Seed local Firestore",
      "type": "shell",
      "command": "npm",
      "args": ["run", "seed"],
      "options": {
        "cwd": "${workspaceFolder}/tool/seed"
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare Firebase emulator",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install seed dependencies",
        "Start Firebase emulators",
        "Seed local Firestore"
      ],
      "problemMatcher": []
    }
  ]
}
