rules_version = '2';

// Security rules for the collections in docs/firestore-schema.md.
// Fixed data (categories, pickupHubs, officialHandles, communities,
// trendingTopics) is written only by the seed script, which uses the Admin
// SDK and is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Only these keys may change in an update.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      // Counters and verification are set by the backend, not the app.
      allow update: if isSelf(uid) && onlyChanges([
        'name', 'handle', 'avatarPath', 'cohort', 'isOnline', 'bio',
        'bioHighlight', 'program', 'campus', 'roleTag'
      ]);
      allow delete: if false;

      // Per-user state: only the owner can see or change it.
      match /likedPosts/{postId} {
        allow read, write: if isSelf(uid);
      }
      match /savedListings/{listingId} {
        allow read, write: if isSelf(uid);
      }
      match /memberships/{groupId} {
        allow read, write: if isSelf(uid);
      }
      match /following/{targetId} {
        allow read, write: if isSelf(uid);
      }
      // Generated by the backend.
      match /peerSuggestions/{otherId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------- posts
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      // The author edits content; anyone signed in can move likeCount by one
      // (FirebasePostsRepository.setLiked does this in a transaction with
      // users/{uid}/likedPosts).
      allow update: if (
          signedIn() && resource.data.authorId == request.auth.uid
          && onlyChanges(['body', 'title', 'topic', 'audience', 'imagePath', 'imageCaption', 'event'])
        ) || (
          signedIn() && onlyChanges(['likeCount'])
          && (request.resource.data.likeCount - resource.data.likeCount) in [1, -1]
        );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // ------------------------------------------------------------- listings
    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    // -------------------------------------------------------- conversations
    match /conversations/{conversationId} {
      function isParticipant(data) {
        return signedIn() && request.auth.uid in data.participantIds;
      }

      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data)
        && request.resource.data.participantIds.size() == 2;
      // Participants update lastMessage, updatedAt and unread counts.
      allow update: if isParticipant(resource.data)
        && onlyChanges(['lastMessage', 'updatedAt', 'unreadCounts']);
      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isParticipant(conversation());
        allow create: if isParticipant(conversation())
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------ fixed data
    match /categories/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /pickupHubs/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /officialHandles/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /communities/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /trendingTopics/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
