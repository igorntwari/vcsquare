rules_version = '2';

// Files are grouped by owner so each user can only write their own folder.
//   avatars/{uid}/{file}              profile photo
//   listings/{uid}/{listingId}/{file} marketplace photos
//   posts/{uid}/{postId}/{file}       feed photos
service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && isImageUnder5MB();
      allow delete: if isOwner(uid);
    }

    match /listings/{uid}/{listingId}/{file} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && isImageUnder5MB();
      allow delete: if isOwner(uid);
    }

    match /posts/{uid}/{postId}/{file} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && isImageUnder5MB();
      allow delete: if isOwner(uid);
    }
  }
}
